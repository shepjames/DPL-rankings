# ============================================================
# Job Search Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git — it contains secrets.
# ============================================================

# --- Job Search APIs (need at least one) ---

# Serper.dev — Primary source (Google Search API)
# Sign up free: https://serper.dev/
# Free tier: 2,500 searches
SERPER_API_KEY=your_serper_api_key_here

# JSearch API (RapidAPI) — Optional secondary source
# Sign up free: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=your_rapidapi_key_here

# Adzuna API — Optional secondary source
# Sign up free: https://developer.adzuna.com/
# ADZUNA_APP_ID=your_adzuna_app_id
# ADZUNA_APP_KEY=your_adzuna_app_key

# --- Gmail SMTP ---

# Your Gmail address
GMAIL_ADDRESS=shepjames@gmail.com

# Gmail App Password (NOT your regular password)
# To generate:
#   1. Go to myaccount.google.com
#   2. Security > 2-Step Verification (enable if not already)
#   3. Search for "App passwords" or go to Security > App passwords
#   4. Create a new app password for "Mail"
#   5. Copy the 16-character password here (spaces are fine to remove)
GMAIL_APP_PASSWORD=your_16_char_app_password
